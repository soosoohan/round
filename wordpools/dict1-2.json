{ "text": "밤이 지나 날이 밝아오도록", "hint": "밤새" },
{ "text": "달콤한 맛이 나다", "hint": "달달하다" },
{ "text": "일을 다 마쳐 이룸", "hint": "완성" },
{ "text": "현실에서 불가능한 괴상하고 이상한 일을 하는 기술", "hint": "요술" },
{ "text": "게으르지 않고 열심히 일하다", "hint": "부지런하다" },
{ "text": "농사를 짓는 사람", "hint": "농부" },
{ "text": "농사에 쓰는 연장", "hint": "농기구" },
{ "text": "손에 들고 땅을 파는  작은 농기구", "hint": "호미" },
{ "text": "되풀이하여 계속", "hint": "자꾸자꾸" },
{ "text": "만약에", "hint": "혹시나" },
{ "text": "높은 벼슬아치를 부르는 말", "hint": "대감" },
{ "text": "고려와 조선시대에 고을을 다스리던 사또", "hint": "원님" },
{ "text": "옳고 그름을 판단하여 결정함", "hint": "판결" },
{ "text": "어느 쪽으로 치우치지 않고 고르게", "hint": "공평하게" },
{ "text": "임금을 높여 부르는 말", "hint": "나라님" },
{ "text": "웃어른께 물건을 드리다", "hint": "바치다" },
{ "text": "잘못 없는데 꾸중을 들어 분하다", "hint": "억울하다" },
{ "text": "금으로 만든 돈", "hint": "금화" },
{ "text": "한옥에서 안쪽 건물", "hint": "안채" },
{ "text": "누에고치에서 뽑은 명주실로 광택이 나게 짠 옷감", "hint": "비단" },
{ "text": "끊지 않고 잇따라", "hint": "계속" },
{ "text": "남을 괴롭히려는 못된 마음", "hint": "심술" },
{ "text": "아무 이상이 없이 튼튼하다", "hint": "멀쩡하다" },
{ "text": "만약에", "hint": "혹시" },
{ "text": "그럴 리는 없겠지만", "hint": "설마" }, 
{ "text": "매우 엉망이고 뒤죽박죽인 상태", "hint": "엉망진창" },
{ "text": "도움을 청하다", "hint": "부탁하다" },
{ "text": "자기가 한 일이 틀렸음을 알다", "hint": "잘못을 깨닫다" },
{ "text": "잘못해서 꾸중을 듣다", "hint": "혼이 나다" },
{ "text": "같은 말을 자꾸 되풀이하여 하는 말", "hint": "잔소리" },
{ "text": "편하지 않고 거북하다", "hint": "불편하다" },
{ "text": "기계나 물건이 제대로 작동하지 않음", "hint": "고장" },
{ "text": "감동하여 마음속이 꽉 찬 것 같은 느낌", "hint": "뭉클하다" },
{ "text": "익숙하지 않아 자연스럽지 못하다", "hint": "어색하다" },
{ "text": "만나서 기쁘고 좋다", "hint": "반갑다" },
{ "text": "살짝 건드려 가렵게 하는 모양", "hint": "간질간질" },
{ "text": "틀림없는지 알아보다", "hint": "확인하다" },
{ "text": "생각이나 느낌을 말이나 행동으로 나타내다", "hint": "표현하다" },
{ "text": "배운 것을 잘 이용하여 쓰다", "hint": "활용하다" }
]
